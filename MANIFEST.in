# Cosa entra nello sdist di st-language: la libreria (st_language/), la
# specifica con la suite di conformita' e gli esempi; non l'applicazione
# SoundText ne' i suoi test, che non fanno parte del pacchetto.
include LICENSE
include THIRD_PARTY_NOTICES.md
include licenses/mtxt.txt
include st_language/README.md
include docs/spec/ST-language.md
include docs/spec/ST-language.it.md
include docs/spec/conformance/README.md
include docs/spec/conformance/cases.json
include docs/spec/conformance/make_cases.py
include docs/spec/conformance/run_installed.py
include examples/blues_12bar.st
prune tests
prune core
prune gui
prune songs
prune midi
prune assets
prune locales
